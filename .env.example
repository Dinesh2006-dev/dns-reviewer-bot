# Copy this file to .env and fill in your values
# Never commit .env to GitHub!

# GitHub Personal Access Token (PAT)
# WHY NEEDED: Required to authenticate requests to the GitHub API. It enables the agent to
# fetch PR details, read the zone file diffs, post review comments, and apply labels.
GITHUB_TOKEN=your_github_pat_here

# GitHub repository (owner/repo-name)
# WHY NEEDED: Tells the agent which repository to look up on GitHub.
GITHUB_REPO=yourusername/your-repo-name

# PR number to review
# WHY NEEDED: The target Pull Request number that the agent will review. (In GitHub Actions,
# this is supplied automatically; for local testing, set this to your test PR number).
PR_NUMBER=1

# Optional: Discord webhook for team notifications
# WHY NEEDED: If set, the agent sends a notification message with the PR review summary 
# and risk score directly to a Discord channel immediately after the review is posted.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# Ollama settings (defaults work if Ollama running locally)
# WHY NEEDED: Configures the connection to your local, offline LLM server. It is used 
# automatically as a fallback when OPENROUTER_API_KEY is not defined.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=mistral

# Optional: OpenRouter API Key for high-speed free cloud analysis
# WHY NEEDED: Switches LLM analysis to OpenRouter Cloud. This avoids downloading a 4GB local model 
# in CI/CD runners, allowing the GitHub Actions pipeline to run in seconds.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Configures which free cloud model slug to query via OpenRouter API.
# Defaults to google/gemma-4-31b-it:free (or openrouter/free).
OPENROUTER_MODEL=google/gemma-4-31b-it:free

